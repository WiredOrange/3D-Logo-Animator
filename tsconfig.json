{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["examples/studio/*"],
      "@wiredorange/3d-logo-animator": ["src/index.ts"],
      "@wiredorange/3d-logo-animator/react": ["src/react/index.tsx"],
      "@wiredorange/3d-logo-animator/engine": ["src/engine.ts"]
    }
  },
  "include": ["src", "examples", "vite.config.ts"]
}
