{
  "name": "@wiredorange/3d-logo-animator",
  "version": "0.1.0",
  "description": "Embeddable 3D logo animation engine, React adapter, and Logo Flight studio.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./react": { "types": "./dist/react/index.d.ts", "import": "./dist/react/index.js" },
    "./engine": { "types": "./dist/engine.d.ts", "import": "./dist/engine.js" }
  },
  "files": ["dist", "src", "README.md", "docs", "THIRD_PARTY_NOTICES.md"],
  "repository": { "type": "git", "url": "https://github.com/WiredOrange/3D-Logo-Animator.git" },
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --experimental-test-module-mocks --test tests/*.test.mjs",
    "dev": "vite --host 0.0.0.0",
    "build:examples": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run typecheck && npm test && npm run build:examples",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@types/three": "0.186.0",
    "d3-contour": "4.0.2",
    "fflate": "0.8.3",
    "three": "0.186.0"
  },
  "peerDependencies": { "react": "^18.2.0 || ^19.0.0" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-contour": "3.0.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
